  "item": [
    {
      "name": "CP-01 Listado: Listar tareas activas (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-01: Status 200 al listar tareas', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-01: Retorna arreglo de tareas activas', function () {",
              "  const json = pm.response.json();",
              "  const lista = Array.isArray(json) ? json : (json.data || json.tareas || []);",
              "  pm.expect(Array.isArray(lista)).to.be.true;",
              "  lista.forEach(t => {",
              "    if (t.activo !== undefined) {",
              "      pm.expect(Number(t.activo)).to.not.eql(0);",
              "    }",
              "  });",
              "  if (lista.length > 0) {",
              "    pm.collectionVariables.set('id_existente', String(lista[0].id));",
              "  }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "CP-02 Detalle: Consultar tarea por ID (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas/{{id_existente}}",
