    {
      "name": "CP-07 Verificacion: Tarea eliminada no figura en listado activo (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
