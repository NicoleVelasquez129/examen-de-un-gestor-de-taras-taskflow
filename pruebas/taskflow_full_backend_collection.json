    {
      "name": "CP-05 Codigo unico: Evitar codigos duplicados (POST ignora/rechaza duplicado)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"categoria_id\":1,\"responsable\":\"Nicole\",\"descripcion\":\"Intento con codigo_tarea duplicado\",\"prioridad\":\"MEDIA\",\"codigo_tarea\":\"{{codigo_creada}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-05: Si crea (201) genera codigo distinto; o rechaza con 400/409', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
              "  if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    const tarea = body.data || body.tarea || body;",
              "    pm.expect(String(tarea.codigo_tarea)).to.not.eql(String(pm.collectionVariables.get('codigo_creada')));",
              "    pm.collectionVariables.set('id_segunda_creada', String(tarea.id));",
              "  }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
