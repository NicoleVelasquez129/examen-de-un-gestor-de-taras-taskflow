    {
      "name": "CP-03 Creacion: Crear tarea valida (POST 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"categoria_id\":1,\"responsable\":\"Nicole\",\"descripcion\":\"Tarea de verificacion integral del backend\",\"prioridad\":\"ALTA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-03: Status 201 al crear tarea valida', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('CP-03: Tarea creada en estado PENDIENTE con codigo generado', function () {",
              "  const body = pm.response.json();",
              "  const tarea = body.data || body.tarea || body;",
              "  pm.expect(tarea.estado).to.eql('PENDIENTE');",
              "  pm.expect(tarea.codigo_tarea).to.be.a('string').and.not.be.empty;",
              "  pm.collectionVariables.set('id_creada', String(tarea.id));",
              "  pm.collectionVariables.set('codigo_creada', String(tarea.codigo_tarea));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
