              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-02: Retorna objeto de tarea con ID esperado', function () {",
              "  const body = pm.response.json();",
              "  const tarea = body.data || body.tarea || body;",
              "  pm.expect(tarea).to.be.an('object');",
              "  pm.expect(String(tarea.id)).to.eql(String(pm.collectionVariables.get('id_existente')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
