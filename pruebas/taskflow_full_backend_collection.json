            "exec": [
              "pm.test('CP-07: Status 200 al listar tras eliminacion logica', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-07: La tarea eliminada ya no aparece en el listado activo', function () {",
              "  const json = pm.response.json();",
              "  const lista = Array.isArray(json) ? json : (json.data || json.tareas || []);",
              "  const idElim = String(pm.collectionVariables.get('id_creada'));",
              "  const encontrada = lista.some(t => String(t.id) === idElim);",
              "  pm.expect(encontrada).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
