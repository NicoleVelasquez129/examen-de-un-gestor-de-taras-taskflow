{
  "info": {
    "name": "TaskFlow - Pruebas Filtros y Busqueda GET /api/tareas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Listado general y excluye eliminadas (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna lista sin tareas eliminadas', function () {",
              "  const json = pm.response.json();",
              "  const lista = Array.isArray(json) ? json : (json.data || json.tareas || []);",
              "  pm.expect(Array.isArray(lista)).to.be.true;",
              "  lista.forEach(t => {",
              "    if (typeof t.eliminada === 'boolean') {",
              "      pm.expect(t.eliminada).to.be.false;",
              "    }",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Filtro valido por estado=COMPLETADA (200)",
      "request": {
