  "item": [
    {
      "name": "GET Tareas - Resolver ID de Tarea A (004)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200 al listar tareas', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const lista = Array.isArray(json) ? json : (json.data || json.tareas || []);",
              "",
              "const tareaA = lista.find(t => t.codigo_tarea === 'TAR-20261123-004') || lista.find(t => t.estado === 'PENDIENTE') || lista[0];",
              "pm.collectionVariables.set('id_a', String(tareaA ? tareaA.id : ''));",
              "console.log('id_a:', pm.collectionVariables.get('id_a'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST Crear Tarea B en PENDIENTE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"categoria_id\":1,\"responsable\":\"Nicole\",\"descripcion\":\"Tarea B para probar la cancelación\",\"prioridad\":\"BAJA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 201 al crear Tarea B', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "const tareaB = body.data || body.tarea || body;",
              "pm.collectionVariables.set('id_b', String(tareaB ? tareaB.id : ''));",
              "pm.expect(tareaB.estado).to.eql('PENDIENTE');",
              "if (!pm.collectionVariables.get('id_eliminada') && tareaB && tareaB.id) {",
              "  pm.collectionVariables.set('id_eliminada', String(Number(tareaB.id) + 1));",
              "}",
              "console.log('id_b:', pm.collectionVariables.get('id_b'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
