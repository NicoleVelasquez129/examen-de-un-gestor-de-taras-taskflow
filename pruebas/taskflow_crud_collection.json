    {
      "name": "Ya no aparece en el listado (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('La tarea eliminada ya no esta en el listado', function () {",
              "  const json = pm.response.json();",
              "  const lista = Array.isArray(json) ? json : (json.data || json.tareas || []);",
              "  const idEliminado = String(pm.collectionVariables.get('id_eliminar'));",
              "  const existe = lista.some(t => String(t.id) === idEliminado);",
              "  pm.expect(existe).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
