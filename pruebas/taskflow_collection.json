{
  "info": {
    "name": "TaskFlow - Pruebas API Tareas y Categorias",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Categorias (4 categorias esperadas)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/categorias",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "categorias"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna las 4 categorias', function () {",
              "  const json = pm.response.json();",
              "  const lista = Array.isArray(json) ? json : (json.data || json.categorias || []);",
              "  pm.expect(lista.length).to.eql(4);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "CP-01 Tarea valida (201, PENDIENTE, TAR-20261123-004)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"categoria_id\":1,\"responsable\":\"Nicole\",\"descripcion\":\"Escribir el informe final del proyecto\",\"prioridad\":\"ALTA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Estado PENDIENTE y codigo TAR-20261123-004', function () {",
              "  const body = pm.response.json();",
              "  const tarea = body.data || body.tarea || body;",
              "  pm.expect(tarea.estado).to.eql('PENDIENTE');",
              "  pm.expect(tarea.codigo_tarea).to.eql('TAR-20261123-004');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
