    {
      "name": "Campos de sistema ignorados (201, PENDIENTE, TAR-20261123-005)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"categoria_id\":1,\"responsable\":\"Nicole\",\"descripcion\":\"Escribir el informe final del proyecto\",\"prioridad\":\"BAJA\",\"estado\":\"COMPLETADA\",\"codigo_tarea\":\"HACK\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Ignora estado COMPLETADA y codigo HACK', function () {",
              "  const body = pm.response.json();",
              "  const tarea = body.data || body.tarea || body;",
              "  pm.expect(tarea.estado).to.eql('PENDIENTE');",
              "  pm.expect(tarea.codigo_tarea).to.eql('TAR-20261123-005');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
