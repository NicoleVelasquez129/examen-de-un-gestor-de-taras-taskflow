{
  "info": {
    "name": "TaskFlow - Pruebas Busqueda y Filtros CP-01 a CP-12",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CP-01 Listar tareas activas (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-01: Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-01: Estructura JSON valida y sin tareas inactivas (activo != 0)', function () {",
              "  const json = pm.response.json();",
              "  const lista = Array.isArray(json) ? json : (json.data || json.tareas || []);",
              "  pm.expect(Array.isArray(lista)).to.be.true;",
              "  lista.forEach(t => {",
              "    if (t.activo !== undefined) {",
              "      pm.expect(Number(t.activo)).to.not.eql(0);",
              "      pm.expect(Boolean(t.activo)).to.be.true;",
              "    }",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "CP-02 Buscar por codigo (?texto=TAR-)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tareas?texto=TAR-",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "tareas"],
          "query": [
            {
              "key": "texto",
              "value": "TAR-"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CP-02: Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('CP-02: Coincidencias por codigo y sin tareas con activo = 0', function () {",
              "  const json = pm.response.json();",
              "  const lista = Array.isArray(json) ? json : (json.data || json.tareas || []);",
              "  pm.expect(Array.isArray(lista)).to.be.true;",
              "  lista.forEach(t => {",
              "    if (t.activo !== undefined) pm.expect(Number(t.activo)).to.not.eql(0);",
              "    const catNombre = (t.Categoria && t.Categoria.nombre) || (t.categoria && t.categoria.nombre) || '';",
              "    const textoCompleto = `${t.codigo_tarea || ''} ${t.responsable || ''} ${t.descripcion || ''} ${catNombre}`.toLowerCase();",
              "    pm.expect(textoCompleto).to.include('tar-');",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
